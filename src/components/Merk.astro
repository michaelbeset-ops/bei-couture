---
// Hun eigen logo. Donkere versie op licht, lichte versie op donker.
import { Image } from 'astro:assets';
import { url, site } from '../data/site';
import logoRond from '../assets/logo-rond.png';

interface Props { donker?: boolean; class?: string; groot?: boolean; link?: boolean; prioriteit?: boolean }
const { donker = false, class: cls = '', groot = false, link = true, prioriteit = false } = Astro.props;

// Het volledige logo: witte cirkel met stiksel, de naam en het strikje. Staat op elk donker vlak.
const bron = logoRond;
const maat = groot ? 'h-28 w-auto md:h-36' : 'h-[4.5rem] w-auto md:h-24';
const Tag = link ? 'a' : 'div';
---
<Tag
  {...link ? { href: url(''), 'aria-label': `${site.naam}, naar de homepage` } : {}}
  class={`inline-flex flex-none items-center no-underline ${link ? 'transition-opacity duration-300 hover:opacity-80' : ''} ${cls}`}
>
  <Image src={bron} alt={`${site.naam}, bruidsatelier in Rotterdam`} widths={[160, 240, 320]} sizes={groot ? "(min-width: 768px) 124px, 96px" : "(min-width: 768px) 82px, 62px"} class={`${maat} object-contain`} loading={prioriteit ? 'eager' : 'lazy'} fetchpriority={prioriteit ? 'high' : 'auto'} quality={75} />
</Tag>
