---
// Bezoekblok: adres, contact en de openingstijden met het blok voor afspraken buiten de tijden.
// Zelfde blok op de homepage en onderaan de dienstpagina's.
import { site, werkgebied, waHoi } from '../data/site';
import Icoon from './Icoon.astro';
import Tijden from './Tijden.astro';
---
<section id="bezoek" class="bg-strik-zacht py-16 md:py-24">
  <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-14">
    <div class="min-w-0 lg:col-span-5">
      <p class="eyebrow">Bezoek het atelier</p>
      <h2 class="mt-5 text-[2.2rem] md:text-[2.8rem]">Hoogstraat <span class="text-merk">89A</span></h2>
      <p class="mt-6 text-steen">Het atelier zit midden in Rotterdam, in het pand van {site.inPand}. Bruiden komen uit de hele regio: {werkgebied.slice(1, 7).join(', ')} en verder.</p>
      <ul class="mt-8 space-y-4">
        <li class="flex gap-4"><Icoon naam="pin" class="mt-1 h-5 w-5 flex-none text-merk" /><span>{site.straat}, {site.postcode} {site.plaats}<br /><span class="text-sm text-steen">Gevestigd in {site.inPand}</span></span></li>
        <li class="flex gap-4"><Icoon naam="tel" class="mt-1 h-5 w-5 flex-none text-merk" /><a href={site.telHref} class="link num">{site.tel}</a></li>
        <li class="flex gap-4"><Icoon naam="mail" class="mt-1 h-5 w-5 flex-none text-merk" /><a href={`mailto:${site.mail}`} class="link">{site.mail}</a></li>
      </ul>
      <div class="mt-7 flex flex-wrap gap-3 md:mt-9">
        <a href={site.route} class="knop knop-inkt"><Icoon naam="pin" />Route plannen</a>
        <a href={waHoi} class="knop knop-rand bg-wit"><Icoon naam="wa" />WhatsApp</a>
      </div>
    </div>
    <div class="lg:col-span-7">
      <Tijden />
    </div>
  </div>
</section>

