---
// Lijn-iconen 24x24. WhatsApp en de Google-G zijn de bekende merktekens.
interface Props { naam: string; class?: string }
const { naam, class: cls = '' } = Astro.props;
const lijn = { fill: 'none', stroke: 'currentColor', 'stroke-width': '1.7', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' };
---
{naam === 'wa' && (
  <svg class={cls} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2a9.9 9.9 0 0 0-8.5 15l-1.4 5 5.2-1.36A9.9 9.9 0 1 0 12.04 2Zm0 18.1a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.08.81.82-3-.2-.31a8.2 8.2 0 1 1 6.94 3.83Zm4.5-6.14c-.25-.12-1.46-.72-1.69-.8-.23-.08-.39-.12-.56.12-.16.25-.64.8-.79.97-.14.16-.29.18-.54.06a6.7 6.7 0 0 1-1.98-1.22 7.4 7.4 0 0 1-1.37-1.7c-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.15.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.42h-.47a.9.9 0 0 0-.66.31 2.77 2.77 0 0 0-.86 2.06 4.8 4.8 0 0 0 1 2.56 11 11 0 0 0 4.2 3.71c.59.25 1.05.4 1.4.52.6.19 1.13.16 1.56.1.48-.07 1.46-.6 1.67-1.18.2-.58.2-1.07.14-1.18-.06-.1-.22-.16-.47-.29Z"/></svg>
)}
{naam === 'tel' && <svg class={cls} viewBox="0 0 24 24" {...lijn} aria-hidden="true"><path d="M5 4h3.5l1.7 4.3-2.2 1.4a11 11 0 0 0 6.3 6.3l1.4-2.2L20 15.5V19a1.5 1.5 0 0 1-1.6 1.5A16.5 16.5 0 0 1 3.5 5.6 1.5 1.5 0 0 1 5 4Z"/></svg>}
{naam === 'pijl' && <svg class={cls} viewBox="0 0 24 24" {...lijn} stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>}
{naam === 'vink' && <svg class={cls} viewBox="0 0 24 24" {...lijn} stroke-width="2.3" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>}
{naam === 'ster' && <svg class={cls} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2.8 2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8L12 2.8Z"/></svg>}
{naam === 'pin' && <svg class={cls} viewBox="0 0 24 24" {...lijn} aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/></svg>}
{naam === 'klok' && <svg class={cls} viewBox="0 0 24 24" {...lijn} aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>}
{naam === 'mail' && <svg class={cls} viewBox="0 0 24 24" {...lijn} aria-hidden="true"><rect x="3.5" y="5.5" width="17" height="13" rx="1.5"/><path d="m4 6.5 8 6 8-6"/></svg>}
{naam === 'schaar' && <svg class={cls} viewBox="0 0 24 24" {...lijn} aria-hidden="true"><circle cx="6.5" cy="17.5" r="2.8"/><circle cx="17.5" cy="17.5" r="2.8"/><path d="M8.6 15.6 18 4M15.4 15.6 6 4"/></svg>}
{naam === 'naald' && <svg class={cls} viewBox="0 0 24 24" {...lijn} aria-hidden="true"><path d="M19.5 4.5 6 18l-2 2 .6-2.6L18 4a1 1 0 0 1 1.5.5Z"/><path d="M17 6.2l1 1"/><path d="M4.5 19.5c3-1 5.5 1.5 9 0s4-5 6.5-5" stroke-dasharray="1.6 2.2"/></svg>}
{naam === 'meet' && <svg class={cls} viewBox="0 0 24 24" {...lijn} aria-hidden="true"><path d="M3.5 9.5h17v6h-17z"/><path d="M7 9.5v2.5M10.5 9.5v3.5M14 9.5v2.5M17.5 9.5v3.5"/></svg>}
{naam === 'foto' && <svg class={cls} viewBox="0 0 24 24" {...lijn} aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="12" cy="12" r="3.2"/><path d="M8 5l1.2-2h5.6L16 5"/></svg>}
{naam === 'hart' && <svg class={cls} viewBox="0 0 24 24" {...lijn} aria-hidden="true"><path d="M12 20s-7.5-4.6-7.5-10A4.3 4.3 0 0 1 12 7.4 4.3 4.3 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10Z"/></svg>}
{naam === 'g' && (
  <svg class={cls} viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.6 12.3c0-.8-.1-1.4-.2-2.1H12v4h6a5.2 5.2 0 0 1-2.2 3.4v2.8h3.6c2-1.9 3.2-4.7 3.2-8.1Z"/><path fill="#34A853" d="M12 23c3 0 5.5-1 7.4-2.7l-3.6-2.8c-1 .7-2.3 1.1-3.8 1.1-2.9 0-5.4-2-6.3-4.6H2v2.9A11 11 0 0 0 12 23Z"/><path fill="#FBBC05" d="M5.7 14a6.6 6.6 0 0 1 0-4.1V7H2a11 11 0 0 0 0 9.9L5.7 14Z"/><path fill="#EA4335" d="M12 5.4c1.6 0 3.1.6 4.2 1.7l3.2-3.2A11 11 0 0 0 2 7l3.7 2.9C6.6 7.3 9.1 5.4 12 5.4Z"/></svg>
)}
