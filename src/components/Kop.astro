---
import { url, waHoi, site } from '../data/site';
import { diensten } from '../data/diensten';
import Icoon from './Icoon.astro';
import Merk from './Merk.astro';

// opFoto: de kop staat over de donkere hero van de pagina (doorzichtig).
// Staat de pagina bovenaan licht, dan krijgt de kop zelf de donkere achtergrond.
interface Props { opFoto?: boolean }
const { opFoto = true } = Astro.props;

const pad = Astro.url.pathname.replace(/\/+$/, '');
const hier = (p: string) => pad === url(p).replace(/\/+$/, '');
const dienstActief = diensten.some((d) => hier(`${d.slug}/`));

const nav: { href: string; t: string; actief: boolean }[] = [
  { href: url('werkwijze/'), t: 'Werkwijze', actief: hier('werkwijze/') },
  { href: url('klantervaringen/'), t: 'Klantervaringen', actief: hier('klantervaringen/') },
  { href: url('over-bei/'), t: 'Over Bei', actief: hier('over-bei/') },
  { href: url('contact/'), t: 'Contact', actief: hier('contact/') },
];
---
<header class={opFoto ? 'absolute inset-x-0 top-0 z-40' : 'relative z-40 bg-inkt'}>
  <div class="hidden border-b border-lijn lg:block">
    <div class="wrap flex h-11 items-center justify-between gap-6 text-[.875rem] text-wit/85">
      <ul class="flex gap-7">
        <li class="flex items-center gap-2"><Icoon naam="pin" class="h-4 w-4 text-strik" />{site.straat}, {site.plaats}</li>
        <li class="flex items-center gap-2"><Icoon naam="klok" class="h-4 w-4 text-strik" />Di t/m vr 11:00 tot 17:00, zondag 12:00 tot 17:00</li>
        <li class="flex items-center gap-2"><Icoon naam="kalender" class="h-4 w-4 text-strik" />Ook op afspraak buiten de openingstijden</li>
      </ul>
      <a href={site.telHref} class="num flex items-center gap-2 text-wit/85 no-underline hover:text-wit"><Icoon naam="tel" class="h-4 w-4 text-strik" />{site.tel}</a>
    </div>
  </div>

  <div class="wrap flex h-20 items-center justify-between gap-3 md:h-24 md:gap-8">
    <Merk donker />

    <nav aria-label="Hoofdmenu" class="hidden lg:block">
      <ul class="flex items-center gap-7 text-[1.02rem] font-medium">
        <li class="group relative">
          <a href={url('atelier/')} class={`flex items-center gap-1.5 py-6 no-underline transition-colors hover:text-strik ${dienstActief ? 'text-strik' : 'text-wit/90'}`} aria-haspopup="true">
            Atelier
            <svg viewBox="0 0 24 24" class="h-4 w-4 transition-transform duration-300 group-hover:rotate-180" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
          </a>
          <div class="invisible absolute left-1/2 top-full z-50 w-[17rem] -translate-x-1/2 translate-y-1 opacity-0 transition-all duration-200 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">
            <ul class="kaart overflow-hidden py-2 shadow-[0_26px_60px_-30px_#1b1716a6]">
              {diensten.map((d) => (
                <li>
                  <a href={url(`${d.slug}/`)} class={`block px-5 py-2 text-[.98rem] leading-snug no-underline transition-colors hover:bg-ivoor hover:text-merk ${hier(`${d.slug}/`) ? 'text-merk' : 'text-inkt'}`}>{d.kaartTitel}</a>
                </li>
              ))}
              <li class="mt-1 border-t border-ivoor-3 pt-1">
                <a href={url('atelier/')} class="block px-5 py-2 text-[.98rem] text-steen no-underline transition-colors hover:bg-ivoor hover:text-merk">Alles in het atelier</a>
              </li>
            </ul>
          </div>
        </li>
        {nav.map((n) => (
          <li><a href={n.href} class={`py-6 no-underline transition-colors hover:text-strik ${n.actief ? 'text-strik' : 'text-wit/90'}`}>{n.t}</a></li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a href={url('contact/')} class="knop knop-merk hidden min-h-11 px-5 text-[1rem] md:inline-flex">Afspraak maken</a>
      <button type="button" class="grid h-11 w-11 place-items-center text-wit lg:hidden" aria-expanded="false" aria-controls="menu-nav" data-menu-knop>
        <span class="sr-only">Menu</span>
        <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16" /></svg>
      </button>
    </div>
  </div>

  <nav id="menu-nav" aria-label="Menu" class="hidden bg-inkt lg:hidden" data-menu>
    <ul class="wrap max-h-[70svh] overflow-y-auto pb-8 pt-2">
      {[...diensten.map((d) => ({ href: url(`${d.slug}/`), t: d.kaartTitel })), ...nav.map((n) => ({ href: n.href, t: n.t }))].map((n) => (
        <li><a href={n.href} class="block border-b border-lijn py-4 font-kop text-2xl font-extrabold tracking-[-.02em] text-wit no-underline">{n.t}</a></li>
      ))}
      <li class="flex flex-wrap gap-3 pt-6">
        <a href={url('contact/')} class="knop knop-merk">Afspraak maken</a>
        <a href={site.telHref} class="knop knop-wit num"><Icoon naam="tel" />{site.tel}</a>
      </li>
    </ul>
  </nav>
</header>

<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 bg-inkt md:hidden">
  <a href={site.telHref} class="flex min-h-14 items-center justify-center gap-2.5 border-r border-lijn text-[1rem] font-semibold text-wit no-underline"><Icoon naam="tel" class="h-5 w-5 text-strik" />Bellen</a>
  <a href={waHoi} class="flex min-h-14 items-center justify-center gap-2.5 bg-merk text-[1rem] font-semibold text-wit no-underline"><Icoon naam="wa" class="h-5 w-5" />WhatsApp</a>
</div>

<script>
  const k = document.querySelector<HTMLButtonElement>('[data-menu-knop]');
  const m = document.querySelector<HTMLElement>('[data-menu]');
  if (k && m) {
    k.addEventListener('click', () => { const o = k.getAttribute('aria-expanded') !== 'true'; k.setAttribute('aria-expanded', String(o)); m.classList.toggle('hidden', !o); });
    m.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { k.setAttribute('aria-expanded', 'false'); m.classList.add('hidden'); }));
  }
</script>
