---
// Openingstijden met live status. Buiten deze tijden kan er een afspraak gemaakt worden:
// dat staat er bewust groot bij, want veel bruiden kunnen overdeweek niet.
import { site, dagen, volgorde, waMet } from '../data/site';
import Icoon from './Icoon.astro';
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<div class={`border border-merk/20 bg-wit p-4 text-inkt sm:p-6 md:p-8 ${cls}`}>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h2 id="tijden-kop" class="text-[1.5rem] md:text-[1.7rem]">Openingstijden</h2>
    <p class="flex items-center gap-2 text-sm font-semibold"><span class="h-2 w-2 rounded-full bg-steen" data-stip></span><span data-status>Openingstijden</span></p>
  </div>
  <hr class="mt-5 border-merk/20" />
  <table class="num mt-2 w-full text-left" aria-labelledby="tijden-kop">
    <tbody>
      {volgorde.map((d) => { const t = site.tijden[d]; return (
        <tr data-dag={d} class="border-b border-merk/10 last:border-0">
          <th scope="row" class="py-2.5 pl-3 font-medium md:py-3">{dagen[d]}</th>
          <td class={`py-2.5 pr-3 text-right md:py-3 ${t ? '' : 'text-steen'}`}>{t ? `${t[0]}:00 tot ${t[1]}:00` : 'Op afspraak'}</td>
        </tr>
      ); })}
    </tbody>
  </table>

  <div class="mt-5 bg-inkt p-5 text-wit md:mt-6 md:p-7">
    <p class="flex items-center gap-3 font-kop text-[1.4rem] font-normal leading-tight text-strik">
      <Icoon naam="kalender" class="h-6 w-6 flex-none" />
      Ook buiten de openingstijden
    </p>
    <p class="mt-3 text-mist">{site.opAfspraak}</p>
    <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <a href={waMet('Hallo Bei, ik kan niet tijdens de openingstijden. Kunnen we een afspraak buiten de openingstijden inplannen?')} class="knop knop-merk min-h-12 w-full px-5 text-[.9rem] sm:w-auto"><Icoon naam="wa" />Afspraak buiten de tijden</a>
      <a href={site.telHref} class="knop border border-wit/60 num min-h-12 w-full px-5 text-[.9rem] text-wit hover:bg-wit hover:text-inkt sm:w-auto"><Icoon naam="tel" />{site.tel}</a>
    </div>
  </div>
</div>

<script>
  import { site } from '../data/site';
  const nu = new Date(new Date().toLocaleString('en-US', { timeZone: 'Europe/Amsterdam' }));
  const d = nu.getDay(); const u = nu.getHours() + nu.getMinutes() / 60; const t = site.tijden[d];
  const open = !!t && u >= t[0] && u < t[1];
  let tekst = open ? `Nu open tot ${t![1]}:00` : 'Nu gesloten, wel op afspraak';
  if (!open) {
    if (t && u < t[0]) tekst = `Vandaag open vanaf ${t[0]}:00`;
    else { for (let i = 1; i <= 7; i++) { const n = (d + i) % 7; const tt = site.tijden[n]; if (tt) { tekst = `Gesloten, ${i === 1 ? 'morgen' : ['zondag', 'maandag', 'dinsdag', 'woensdag', 'donderdag', 'vrijdag', 'zaterdag'][n]} open vanaf ${tt[0]}:00`; break; } } }
  }
  document.querySelectorAll('[data-nu]').forEach((e) => (e.textContent = open ? `Vandaag open tot ${t![1]}:00` : tekst));
  document.querySelectorAll('[data-status]').forEach((e) => (e.textContent = open ? 'Nu open' : 'Nu gesloten'));
  document.querySelectorAll<HTMLElement>('[data-stip]').forEach((e) => (e.style.background = open ? '#2f8a4f' : '#8f4b4f'));
  document.querySelectorAll(`tr[data-dag="${d}"]`).forEach((e) => { e.classList.add('bg-strik-zacht', 'font-semibold'); e.querySelector('th')?.insertAdjacentHTML('beforeend', '<span class="sr-only"> (vandaag)</span>'); });
</script>
