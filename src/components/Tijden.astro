---
// Openingstijden met live status. Buiten deze tijden kan er een afspraak gemaakt worden:
// dat staat er bewust groot bij, want veel bruiden kunnen overdeweek niet.
import { site, dagen, volgorde, waMet } from '../data/site';
import Icoon from './Icoon.astro';
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<div class={`kaart p-6 md:p-9 ${cls}`}>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h2 class="text-2xl">Openingstijden</h2>
    <p class="flex items-center gap-2 text-sm font-semibold"><span class="h-2 w-2 rounded-full bg-steen" data-stip></span><span data-status>Openingstijden</span></p>
  </div>
  <hr class="naad mt-6" />
  <table class="num mt-2 w-full text-left">
    <tbody>
      {volgorde.map((d) => { const t = site.tijden[d]; return (
        <tr data-dag={d} class="border-b border-ivoor-3 last:border-0">
          <th scope="row" class="py-3.5 pl-3 font-medium">{dagen[d]}</th>
          <td class={`py-3.5 pr-3 text-right ${t ? '' : 'text-steen'}`}>{t ? `${t[0]}:00 tot ${t[1]}:00` : 'Op afspraak'}</td>
        </tr>
      ); })}
    </tbody>
  </table>

  <div class="mt-7 rounded-[10px] bg-strik-zacht p-6 md:p-7">
    <p class="flex items-center gap-3 font-kop text-[1.4rem] font-extrabold leading-tight tracking-[-.015em] text-merk">
      <Icoon naam="kalender" class="h-6 w-6 flex-none" />
      Ook buiten de openingstijden
    </p>
    <p class="mt-3 text-steen">{site.opAfspraak}</p>
    <div class="mt-5 flex flex-wrap gap-3 max-sm:flex-col">
      <a href={waMet('Hallo Bei, ik kan niet tijdens de openingstijden. Kunnen we een afspraak buiten de openingstijden inplannen?')} class="knop knop-merk min-h-12 px-5 text-[1rem]"><Icoon naam="wa" />Afspraak buiten de tijden</a>
      <a href={site.telHref} class="knop knop-rand num min-h-12 px-5 text-[1rem]"><Icoon naam="tel" />{site.tel}</a>
    </div>
  </div>
</div>

<script>
  import { site } from '../data/site';
  const nu = new Date(new Date().toLocaleString('en-US', { timeZone: 'Europe/Amsterdam' }));
  const d = nu.getDay(); const u = nu.getHours() + nu.getMinutes() / 60; const t = site.tijden[d];
  const open = !!t && u >= t[0] && u < t[1];
  let tekst = open ? `Nu open tot ${t![1]}:00` : 'Nu gesloten, wel op afspraak';
  if (!open) {
    if (t && u < t[0]) tekst = `Vandaag open vanaf ${t[0]}:00`;
    else { for (let i = 1; i <= 7; i++) { const n = (d + i) % 7; const tt = site.tijden[n]; if (tt) { tekst = `Gesloten, ${i === 1 ? 'morgen' : ['zondag', 'maandag', 'dinsdag', 'woensdag', 'donderdag', 'vrijdag', 'zaterdag'][n]} open vanaf ${tt[0]}:00`; break; } } }
  }
  document.querySelectorAll('[data-nu]').forEach((e) => (e.textContent = open ? `Vandaag open tot ${t![1]}:00` : tekst));
  document.querySelectorAll('[data-status]').forEach((e) => (e.textContent = open ? 'Nu open' : 'Nu gesloten'));
  document.querySelectorAll<HTMLElement>('[data-stip]').forEach((e) => (e.style.background = open ? '#2f8a4f' : '#8f4b4f'));
  document.querySelectorAll(`tr[data-dag="${d}"]`).forEach((e) => e.classList.add('bg-strik-zacht', 'font-semibold'));
</script>
