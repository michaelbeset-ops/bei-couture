---
import { Picture } from 'astro:assets';
import Kruimels from './Kruimels.astro';
import Icoon from './Icoon.astro';
import { url, site } from '../data/site';

interface Props {
  eyebrow: string;
  h1: string;
  accent?: string;
  lead?: string;
  img?: ImageMetadata;
  alt?: string;
  pos?: string;
  kruimels: { naam: string; href: string }[];
}
const { eyebrow, h1, accent, lead, img, alt = '', pos = '50% 50%', kruimels } = Astro.props;
---
<section class="relative isolate overflow-hidden bg-inkt text-wit">
  {img && (
    <>
      <Picture src={img} formats={['avif', 'webp']} widths={[640, 960, 1400, 2000]} sizes="100vw" alt={alt} loading="eager" fetchpriority="high" class="absolute inset-0 -z-10 h-full w-full object-cover" style={`object-position:${pos}`} />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,#1b1716f2_0%,#1b1716db_45%,#1b171675_100%)] max-md:bg-[linear-gradient(180deg,#1b1716cc_0%,#1b1716e0_60%,#1b1716_100%)]"></div>
    </>
  )}
  <div class="wrap pb-14 pt-28 md:pb-24 md:pt-44">
    <div class="text-mist"><Kruimels items={kruimels} /></div>
    <p class="eyebrow eyebrow-licht mt-8">{eyebrow}</p>
    <h1 class="mt-5 max-w-[16ch] text-4xl">{h1} {accent && <em class="accent-licht">{accent}</em>}</h1>
    {lead && <p class="mt-6 max-w-2xl text-lg text-wit/85 md:text-xl">{lead}</p>}
    <div class="mt-9 flex flex-wrap gap-3">
      <a href={url('contact/')} class="knop knop-merk">Afspraak maken <Icoon naam="pijl" /></a>
      <a href={site.telHref} class="knop knop-wit num"><Icoon naam="tel" />{site.tel}</a>
    </div>
    <p class="mt-6 flex items-center gap-2.5 text-[.95rem] text-wit/80"><Icoon naam="klok" class="h-4 w-4 flex-none text-strik" />Ook op afspraak buiten de openingstijden, ook 's avonds en in het weekend.</p>
  </div>
</section>
