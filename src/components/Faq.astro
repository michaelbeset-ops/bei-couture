---
import Icoon from './Icoon.astro';
interface Props { vragen: { v: string; a: string }[]; kop?: string; achtergrond?: string }
const { vragen, kop = 'Veelgestelde vragen', achtergrond = 'bg-ivoor-2' } = Astro.props;
---
<section class={`${achtergrond} py-16 md:py-24`} aria-labelledby="faq-kop">
  <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <p class="eyebrow">Vragen</p>
      <h2 id="faq-kop" class="mt-5 text-[2.2rem] md:text-[2.6rem]">{kop}</h2>
      <p class="mt-6 text-steen">Staat je vraag er niet bij? Bel of app gerust, je krijgt altijd een eerlijk antwoord over wat er wel en niet kan.</p>
    </div>
    <div class="lg:col-span-8">
      <ul class="divide-y divide-ivoor-3 border-y border-ivoor-3">
        {vragen.map((q) => (
          <li class="vraag">
            <details name="faq">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-6">
                <h3 class="text-[1.35rem] md:text-[1.5rem]">{q.v}</h3>
                <span class="mt-1 grid h-8 w-8 flex-none place-items-center rounded-full border border-ivoor-3 text-merk transition-transform duration-300"><Icoon naam="plus" class="h-4 w-4" /></span>
              </summary>
              <p class="pb-7 pr-12 text-steen">{q.a}</p>
            </details>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
