---
// Google-reviews: links een sfeerfoto, rechts één citaat per keer. Swipen op de telefoon, pijlen op desktop.
// Elk citaat linkt naar het Google-profiel. Compact: de foto bepaalt de hoogte.
import { Picture } from 'astro:assets';
import { site, reviews, url } from '../data/site';
import Icoon from './Icoon.astro';
import satijn from '../assets/satijn.jpg';
interface Props { donker?: boolean }
const { donker = false } = Astro.props;
---
<section id="reviews" class={`${donker ? 'bg-inkt text-wit' : 'bg-ivoor'} py-16 md:py-24`} aria-labelledby="reviews-kop">
  <div class="wrap grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <Picture src={satijn} formats={['avif', 'webp']} widths={[480, 720, 960]} sizes="(min-width: 1024px) 480px, 100vw" alt="Satijnen stof van een trouwjurk, van dichtbij" class="foto aspect-[4/5] w-full object-cover max-lg:aspect-[16/10]" />
    </div>

    <div class="min-w-0 lg:col-span-7 lg:pl-4 xl:pl-10">
      <p class={`eyebrow ${donker ? 'eyebrow-licht' : ''}`}>Google-reviews</p>
      <h2 id="reviews-kop" class="mt-5 text-[2.2rem] md:text-[2.8rem]">Wat bruiden <span class={donker ? 'text-strik' : 'text-merk'}>zeggen</span></h2>

      <ul class="rij mt-8 flex snap-x snap-mandatory overflow-x-auto" data-rij tabindex="0" aria-label="Reviews, horizontaal te scrollen">
        {reviews.map((r) => (
          <li class="w-full flex-none snap-start pr-6">
            <a href={site.reviews} target="_blank" rel="noopener" aria-label={`Review van ${r.naam} op Google lezen`} class="group block no-underline">
              <span class={`flex gap-1 ${donker ? 'text-strik' : 'text-merk'}`}>{[1,2,3,4,5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span>
              <p class={`uitspraak mt-5 max-w-2xl text-[1.45rem] md:text-[1.7rem] ${donker ? 'text-wit' : 'text-inkt'}`}>“{r.tekst}”</p>
              <span class={`mt-6 block text-[.78rem] font-medium uppercase tracking-[.22em] ${donker ? 'text-mist' : 'text-steen'}`}>{r.naam}<span class="normal-case tracking-normal">{` · Google, ${r.wanneer}`}</span></span>
            </a>
          </li>
        ))}
      </ul>

      <div class={`mt-8 flex flex-wrap items-center gap-x-6 gap-y-4 border-t pt-6 ${donker ? 'border-lijn' : 'border-ivoor-3'}`}>
        <div class="flex items-center gap-2">
          <button type="button" data-rij-vorige class={`grid h-10 w-10 place-items-center border transition-colors disabled:opacity-30 ${donker ? 'border-lijn text-wit hover:border-wit' : 'border-ivoor-3 text-inkt hover:border-merk hover:text-merk'}`} aria-label="Vorige review">
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M15 6 9 12l6 6" /></svg>
          </button>
          <button type="button" data-rij-volgende class={`grid h-10 w-10 place-items-center border transition-colors disabled:opacity-30 ${donker ? 'border-lijn text-wit hover:border-wit' : 'border-ivoor-3 text-inkt hover:border-merk hover:text-merk'}`} aria-label="Volgende review">
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
          </button>
        </div>
        <a href={site.reviews} target="_blank" rel="noopener" class={`flex items-center gap-2.5 text-[.95rem] no-underline ${donker ? 'text-wit' : 'text-inkt'}`}>
          <Icoon naam="g" class="h-5 w-5" />
          <span><strong class="num font-semibold">{site.google.score}</strong> uit {site.google.aantal} reviews op Google</span>
        </a>
        <a href={url('klantervaringen/')} class={`text-[.8rem] font-medium uppercase tracking-[.25em] underline underline-offset-[6px] sm:ml-auto ${donker ? 'text-strik decoration-strik/40' : 'text-merk decoration-merk/40'}`}>Alle klantervaringen</a>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-rij]').forEach((rij) => {
    const hoofd = rij.closest('section');
    const vorige = hoofd?.querySelector<HTMLButtonElement>('[data-rij-vorige]');
    const volgende = hoofd?.querySelector<HTMLButtonElement>('[data-rij-volgende]');
    const stap = () => rij.querySelector('li')?.getBoundingClientRect().width ?? 320;
    const bij = () => {
      if (!vorige || !volgende) return;
      vorige.disabled = rij.scrollLeft < 8;
      volgende.disabled = rij.scrollLeft > rij.scrollWidth - rij.clientWidth - 8;
    };
    vorige?.addEventListener('click', () => rij.scrollBy({ left: -(stap() + 20), behavior: 'smooth' }));
    volgende?.addEventListener('click', () => rij.scrollBy({ left: stap() + 20, behavior: 'smooth' }));
    rij.addEventListener('scroll', bij, { passive: true });
    bij();
  });
</script>
