---
// Google-reviews zoals op de andere Sitefront-sites: een rij kleine kaartjes, swipebaar, pijltjes rechtsboven,
// één link naar Google. Elk kaartje linkt naar het Google-profiel.
import { site, reviews } from '../data/site';
import Icoon from './Icoon.astro';
interface Props { donker?: boolean }
const { donker = false } = Astro.props;
---
<section id="reviews" class={`${donker ? 'bg-inkt text-wit' : 'bg-ivoor'} py-14 md:py-20`} aria-labelledby="reviews-kop">
  <div class="wrap">
    <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
      <div>
        <p class={`eyebrow ${donker ? 'eyebrow-licht' : ''}`}>Google-reviews</p>
        <h2 id="reviews-kop" class="mt-4 text-[2rem] md:text-[2.4rem]">Wat bruiden <span class={donker ? 'text-strik' : 'text-merk'}>zeggen</span></h2>
      </div>
      <div class="hidden gap-2 md:flex">
        <button type="button" data-rij-vorige class={`grid h-10 w-10 place-items-center border transition-colors disabled:opacity-30 ${donker ? 'border-lijn text-wit hover:border-wit' : 'border-merk/30 text-inkt hover:border-merk hover:text-merk'}`} aria-label="Vorige reviews">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M15 6 9 12l6 6" /></svg>
        </button>
        <button type="button" data-rij-volgende class={`grid h-10 w-10 place-items-center border transition-colors disabled:opacity-30 ${donker ? 'border-lijn text-wit hover:border-wit' : 'border-merk/30 text-inkt hover:border-merk hover:text-merk'}`} aria-label="Volgende reviews">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
        </button>
      </div>
    </div>

    <ul class="rij mt-8 flex snap-x snap-mandatory gap-5 overflow-x-auto pb-2" data-rij tabindex="0" aria-label="Reviews, horizontaal te scrollen">
      {reviews.map((r) => (
        <li class="w-[82%] max-w-[340px] flex-none snap-start sm:w-[340px]">
          <a href={site.reviews} target="_blank" rel="noopener" aria-label={`Review van ${r.naam} op Google lezen`} class={`flex h-full flex-col p-6 no-underline transition-colors ${donker ? 'bg-inkt-2 hover:bg-[#3a2f2e]' : 'bg-strik-zacht hover:bg-[#f3e2dc]'}`}>
            <span class={`flex gap-0.5 ${donker ? 'text-strik' : 'text-merk'}`}>{[1,2,3,4,5].map(() => <Icoon naam="ster" class="h-3.5 w-3.5" />)}</span>
            <p class={`mt-4 flex-1 text-[.95rem] leading-relaxed ${donker ? 'text-wit/90' : 'text-inkt-2'}`}>{r.tekst}</p>
            <span class={`mt-4 block text-[.85rem] ${donker ? 'text-mist' : 'text-steen'}`}>{r.naam} · via Google</span>
          </a>
        </li>
      ))}
    </ul>

    <p class="mt-6 text-sm">
      <a href={site.reviews} target="_blank" rel="noopener" class={`font-semibold underline decoration-2 underline-offset-[5px] transition-colors ${donker ? 'text-wit decoration-strik hover:text-strik' : 'text-inkt decoration-merk hover:text-merk'}`}>Lees alle {site.google.aantal} reviews op Google</a>
    </p>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-rij]').forEach((rij) => {
    const hoofd = rij.closest('section');
    const vorige = hoofd?.querySelector<HTMLButtonElement>('[data-rij-vorige]');
    const volgende = hoofd?.querySelector<HTMLButtonElement>('[data-rij-volgende]');
    const stap = () => rij.querySelector('li')?.getBoundingClientRect().width ?? 320;
    const bij = () => {
      if (!vorige || !volgende) return;
      vorige.disabled = rij.scrollLeft < 8;
      volgende.disabled = rij.scrollLeft > rij.scrollWidth - rij.clientWidth - 8;
    };
    vorige?.addEventListener('click', () => rij.scrollBy({ left: -(stap() + 20), behavior: 'smooth' }));
    volgende?.addEventListener('click', () => rij.scrollBy({ left: stap() + 20, behavior: 'smooth' }));
    rij.addEventListener('scroll', bij, { passive: true });
    bij();
  });
</script>
