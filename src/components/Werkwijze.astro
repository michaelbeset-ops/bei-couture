---
// De vijf stappen van links naar rechts op één dunne lijn, met een figuurtje per stap,
// de titel en één regel. Op kleine schermen twee kolommen zonder lijn.
import { stappen, url } from '../data/site';
import Icoon from './Icoon.astro';
interface Props { vol?: boolean; achtergrond?: string }
const { vol = false, achtergrond = 'bg-ivoor' } = Astro.props;
---
<section id="werkwijze" class={`${achtergrond} py-16 md:py-20`} aria-labelledby="werkwijze-kop">
  <div class="wrap">
    <div class="grid gap-5 md:grid-cols-12 md:items-end">
      <div class="md:col-span-7">
        <p class="eyebrow">Zo gaat het</p>
        <h2 id="werkwijze-kop" class="mt-4 text-[2.2rem] md:text-[2.6rem]">Van jouw foto tot <span class="text-merk">jouw jurk</span></h2>
      </div>
      <p class="max-w-md text-steen md:col-span-5">Vijf stappen, elk met een eigen afspraak. Je weet steeds waar je staat.<span class="lg:hidden"> Swipe door de stappen.</span></p>
    </div>

    <ol class={`relative mt-9 ${vol ? 'grid gap-x-6 gap-y-8 sm:grid-cols-2 lg:grid-cols-5' : 'rij flex snap-x snap-mandatory gap-6 overflow-x-auto pb-2 max-lg:-mx-5 max-lg:px-5 lg:grid lg:grid-cols-5 lg:gap-x-6 lg:overflow-visible lg:pb-0'}`} data-rij={vol ? undefined : true}>
      <span class="absolute inset-x-0 top-[27px] hidden border-t border-merk/40 lg:block" aria-hidden="true"></span>
      {stappen.map((s, i) => (
        <li class={`rijs relative ${vol ? '' : 'w-[68vw] flex-none snap-start sm:w-[40vw] lg:w-auto'}`} style={`--d:${i * 0.07}s`}>
          <span class={`relative inline-block pr-3 text-merk ${achtergrond}`}><Icoon naam={s.icoon} class="h-[54px] w-[54px]" /></span>
          <h3 class="mt-4 text-[1.35rem] leading-tight">{s.titel}</h3>
          <p class="mt-2 text-[.92rem] leading-relaxed text-steen">{s.kort}</p>
          {vol && <p class="mt-3 text-[.92rem] leading-relaxed text-steen">{s.tekst}</p>}
        </li>
      ))}
    </ol>

    {!vol && (
      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
        <a href={url('afspraak/')} class="knop knop-merk">Afspraak maken</a>
        <a href={url('werkwijze/')} class="text-[.8rem] font-medium uppercase tracking-[.25em] text-merk underline decoration-merk/40 underline-offset-[6px]">De werkwijze helemaal lezen</a>
      </div>
    )}
  </div>
</section>
