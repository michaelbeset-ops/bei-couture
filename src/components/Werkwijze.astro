---
// De vijf stappen van het atelier, van links naar rechts op één doorlopende lijn.
// Op kleine schermen wordt het een verticale lijn met dezelfde punten.
import { stappen, url } from '../data/site';
interface Props { vol?: boolean; achtergrond?: string }
const { vol = false, achtergrond = 'bg-ivoor' } = Astro.props;
---
<section id="werkwijze" class={`${achtergrond} py-24 md:py-32`} aria-labelledby="werkwijze-kop">
  <div class="wrap">
    <div class="grid gap-8 md:grid-cols-12 md:items-end">
      <div class="md:col-span-7">
        <p class="eyebrow">Zo gaat het</p>
        <h2 id="werkwijze-kop" class="mt-5 text-4xl">Van jouw foto tot <em class="accent">jouw jurk.</em></h2>
      </div>
      <p class="text-lg text-steen md:col-span-5">Vijf stappen, elk met een eigen afspraak. Je weet steeds waar je staat en komt nooit voor verrassingen te staan.</p>
    </div>

    <ol class="mt-16 lg:grid lg:grid-cols-5">
      {stappen.map((s, i) => (
        <li class="stap rijs lg:pr-8" style={`--d:${i * 0.07}s`}>
          <h3 class="text-[1.6rem] md:text-[1.75rem]">{s.titel}</h3>
          <p class="mt-3 text-[.98rem] font-medium leading-snug">{s.kort}</p>
          <p class={`mt-3 text-[.95rem] leading-relaxed text-steen ${vol ? '' : 'lg:line-clamp-4'}`}>{s.tekst}</p>
        </li>
      ))}
    </ol>

    {!vol && (
      <div class="mt-14 flex flex-wrap items-center gap-6">
        <a href={url('contact/')} class="knop knop-merk">Afspraak maken</a>
        <a href={url('werkwijze/')} class="tekstlink font-semibold text-merk">De werkwijze helemaal lezen</a>
      </div>
    )}
  </div>
</section>
