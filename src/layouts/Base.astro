---
import '../styles/global.css';
import kopUrl from '@fontsource/bodoni-moda/files/bodoni-moda-latin-800-normal.woff2?url';
import { site, url } from '../data/site';
import { bedrijf, kruimelSchema } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  kruimels?: { naam: string; url: string }[];
  schema?: Record<string, unknown>[];
}
const { title, description, kruimels = [], schema = [] } = Astro.props;

const basis = new URL(url(''), Astro.site).href;
const canoniek = new URL(Astro.url.pathname, Astro.site).href;
const ogAfbeelding = new URL(url('og.jpg'), Astro.site).href;
const logoUrl = new URL(url('logo.png'), Astro.site).href;

const graaf = [
  bedrijf(basis, logoUrl, ogAfbeelding),
  { '@type': 'WebSite', '@id': `${basis}#site`, url: basis, name: site.naam, inLanguage: 'nl-NL', publisher: { '@id': `${basis}#bedrijf` } },
  { '@type': 'WebPage', '@id': canoniek, url: canoniek, name: title, description, isPartOf: { '@id': `${basis}#site` }, about: { '@id': `${basis}#bedrijf` }, inLanguage: 'nl-NL' },
  ...(kruimels.length > 1 ? [kruimelSchema(kruimels)] : []),
  ...schema,
];
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!site.voorstel && <link rel="canonical" href={canoniek} />}
    {site.voorstel ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
    <meta name="theme-color" content={site.themeColor} />
    <meta name="author" content={site.naam} />
    <meta name="geo.region" content="NL-ZH" />
    <meta name="geo.placename" content={site.plaats} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="preload" as="font" type="font/woff2" href={kopUrl} crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogAfbeelding} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canoniek} />
    <meta property="og:site_name" content={site.naam} />
    <meta name="twitter:card" content="summary_large_image" />
    {!site.voorstel && <script type="application/ld+json" is:inline set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graaf })} />}
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body class="min-h-dvh">
    {site.voorstel && (
      <div class="relative z-50 bg-merk text-wit">
        <p class="wrap py-2 text-xs font-medium leading-snug" style="font-family: system-ui, sans-serif">
          Ontwerpvoorstel van Sitefront voor {site.naam}. Dit is niet de officiële website.{" "}
          <a href="https://www.sitefront.nl" class="font-bold underline underline-offset-2">sitefront.nl</a>
        </p>
      </div>
    )}
    <a href="#inhoud" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-sm focus:bg-wit focus:px-4 focus:py-2 focus:text-inkt">Naar de inhoud</a>
    <slot />
    <script>
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -6% 0px' });
      document.querySelectorAll('.rijs').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
