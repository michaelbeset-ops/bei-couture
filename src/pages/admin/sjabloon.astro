---
// Sjabloon voor de bewerkmodus. Als Bei een klantervaring toevoegt of bewerkt, haalt public/beheer/bewerk.js
// van deze pagina het blok met het juiste aantal foto's (0 tot 4) en de juiste kant (links of rechts) en vult
// het live in de pagina Klantervaringen. Zo ziet ze precies wat bezoekers straks zien.
// Niet voor bezoekers (noindex, niet in de sitemap).
import Base from '../../layouts/Base.astro';
import Verhaal from '../../components/Verhaal.astro';
import { diensten } from '../../data/diensten';
import kant from '../../assets/kant.jpg';

const voorbeeld = Array.from({ length: 4 }, () => ({ foto: kant, alt: '' }));
const varianten = [0, 1, 2, 3, 4].flatMap((n) => [0, 1].map((p) => ({ n, p })));
const lijst = diensten.map((d) => ({ slug: d.slug, titel: d.kaartTitel }));
---
<Base title="Sjabloon voor de bewerkmodus" description="Sjabloon van een klantervaring, alleen voor de bewerkmodus." noindex>
  <main id="inhoud" data-b-diensten={JSON.stringify(lijst)}>
    {varianten.map(({ n, p }) => (
      <Verhaal
        i={p}
        kopId={`sjabloon-${n}-${p}`}
        variant={`${n}-${p}`}
        label="Label"
        kop="Kop van de ervaring"
        citaat="Wat de klant zei."
        tekst={['Toelichting van Bei.']}
        naam="Naam"
        sterren={5}
        bron="Google"
        google
        dienst={diensten[0].slug}
        fotos={voorbeeld.slice(0, n)}
      />
    ))}
  </main>
</Base>
