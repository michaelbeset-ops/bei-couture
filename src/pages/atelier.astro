---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import PaginaKop from '../components/PaginaKop.astro';
import Reviews from '../components/Reviews.astro';
import Werkwijze from '../components/Werkwijze.astro';
import Cta from '../components/Cta.astro';
import { url, site } from '../data/site';
import { diensten } from '../data/diensten';
import sMaken from '../assets/s-maken.jpg';

const basis = new URL(url(''), Astro.site).href;
---
<Base
  title="Het atelier van Bei Couture in Rotterdam"
  description="Alles wat bruidsatelier Bei Couture in Rotterdam maakt en vermaakt: bruidsjurken, trouwjurken, bruidsmoeder, bruidsmeisjes, gala en kleding op maat."
  kruimels={[{ naam: 'Home', url: basis }, { naam: 'Atelier', url: new URL(Astro.url.pathname, Astro.site).href }]}
>
  <Kop />
  <main id="inhoud">
    <PaginaKop
      eyebrow="Het atelier"
      h1="Alles wat er in het atelier"
      accent="gemaakt wordt."
      lead="Bei is kleermaker en sinds 2009 gespecialiseerd in bruidsmode. Hieronder staat per onderdeel wat er mogelijk is, van een bruidsjurk die vanaf nul wordt opgebouwd tot een jurk die alleen nog goed moet gaan zitten."
      img={sMaken}
      alt="Kanten lijfje van een bruidsjurk op een paspop in het atelier"
      pos="50% 40%"
      kruimels={[{ naam: 'Home', href: url('') }, { naam: 'Atelier', href: url('atelier/') }]}
    />

    <section class="bg-ivoor py-20 md:py-28">
      <div class="wrap">
        <ul class="grid gap-6 lg:grid-cols-2">
          {diensten.map((d, i) => (
            <li class="rijs" style={`--d:${(i % 2) * 0.08}s`}>
              <a href={url(`${d.slug}/`)} class="fotolink group grid h-full gap-6 sm:grid-cols-[15rem_1fr] sm:items-center">
                <span class="relative block min-h-48 overflow-hidden rounded-[2px] bg-inkt">
                  <Picture src={d.img} formats={['avif', 'webp']} widths={[320, 560]} sizes="(min-width: 640px) 240px, 100vw" alt={d.alt} class="absolute inset-0 h-full w-full object-cover" style={`object-position:${d.pos}`} />
                </span>
                <span class="block">
                  <span class="eyebrow">{d.eyebrow}</span>
                  <h2 class="mt-4 text-[1.7rem]">{d.kaartTitel}</h2>
                  <span class="mt-3 block text-steen">{d.kaartTekst}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-8 text-steen">Staat jouw vraag er niet tussen? Het atelier maakt ook carnavalskleding, turnpakjes en kostuums. Bel of app gerust: <a href={site.telHref} class="link num font-semibold">{site.tel}</a>.</p>
      </div>
    </section>

    <Werkwijze achtergrond="bg-ivoor-2" />
    <Reviews donker />
    <Cta />
  </main>
  <Voet />
</Base>
