---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import PaginaKop from '../components/PaginaKop.astro';
import Reviews from '../components/Reviews.astro';
import Werkwijze from '../components/Werkwijze.astro';
import Cta from '../components/Cta.astro';
import { url, site } from '../data/site';
import { diensten } from '../data/diensten';
import lijfjePaspop from '../assets/lijfje-paspop.jpg';

const basis = new URL(url(''), Astro.site).href;
---
<Base
  title="Het atelier van Bei Couture in Rotterdam"
  description="Alles wat bruidsatelier Bei Couture in Rotterdam maakt en vermaakt: bruidsjurken, trouwjurken, bruidsmoeder, bruidsmeisjes, gala en kleding op maat."
  kruimels={[{ naam: 'Home', url: basis }, { naam: 'Atelier', url: new URL(Astro.url.pathname, Astro.site).href }]}
>
  <Kop />
  <main id="inhoud">
    <PaginaKop
      eyebrow="Het atelier"
      h1="Alles wat er in het atelier"
      accent="gemaakt wordt."
      lead="Bei is kleermaker en sinds 2009 gespecialiseerd in bruidsmode. Hieronder staat per onderdeel wat er mogelijk is, van een bruidsjurk die vanaf nul wordt opgebouwd tot een jurk die alleen nog goed moet gaan zitten."
      img={lijfjePaspop}
      alt="Lijfje met wit kant en pailletten en lange chiffon mouwen op de paspop in het atelier"
      pos="50% 35%"
      kruimels={[{ naam: 'Home', href: url('') }, { naam: 'Atelier', href: url('atelier/') }]}
    />

    <section class="bg-ivoor py-16 md:py-24">
      <div class="wrap">
        <ul class="grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
          {diensten.map((d, i) => (
            <li class="rijs" style={`--d:${(i % 3) * 0.07}s`}>
              <a href={url(`${d.slug}/`)} class="fotolink group block">
                <span class="foto block aspect-[3/4]">
                  <Picture src={d.img} formats={['avif', 'webp']} fallbackFormat="webp" quality={78} widths={[480, 720, 960]} sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw" alt={d.alt} class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" style={`object-position:${d.pos}`} />
                </span>
                <h2 class="mt-5 font-tekst text-[.8rem] font-medium uppercase tracking-[.22em] text-inkt">{d.kaartTitel}</h2>
                <span class="mt-2 block text-[.95rem] text-steen">{d.kaartTekst}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-12 text-steen">Staat jouw vraag er niet tussen? Het atelier maakt ook carnavalskleding, turnpakjes en kostuums. Bel of app gerust: <a href={site.telHref} class="link num font-semibold">{site.tel}</a>.</p>
      </div>
    </section>

    <Werkwijze />
    <Reviews />
    <Cta />
  </main>
  <Voet />
</Base>
