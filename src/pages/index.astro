---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Kop from '../components/Kop.astro';
import Voet from '../components/Voet.astro';
import Icoon from '../components/Icoon.astro';
import Reviews from '../components/Reviews.astro';
import Werkwijze from '../components/Werkwijze.astro';
import Tijden from '../components/Tijden.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import Afspraak from '../components/Afspraak.astro';
import Feiten from '../components/Feiten.astro';
import { site, url, waHoi, werkgebied } from '../data/site';
import { diensten } from '../data/diensten';
import { faqSchema } from '../lib/schema';

import hero from '../assets/hero.jpg';
import bei from '../assets/bei.jpg';

const faq = [
  { v: 'Waar zit bruidsatelier Bei Couture?', a: `Aan de ${site.straat} in ${site.plaats}, in het pand van ${site.inPand}. Het atelier ligt midden in de stad en is goed bereikbaar met het openbaar vervoer.` },
  { v: 'Kan ik buiten de openingstijden langskomen?', a: 'Ja. Het atelier is dinsdag tot en met vrijdag open van 11:00 tot 17:00 en op zondag van 12:00 tot 17:00, maar een afspraak buiten die tijden kan ook, bijvoorbeeld in de avond, op maandag of op zaterdag. Bel of app even, dan zoeken we samen een moment.' },
  { v: 'Moet ik een afspraak maken?', a: 'Voor bruidsmode wel, want daar wordt rustig de tijd voor genomen en die tijd wordt voor jou vrijgehouden. Voor een kleine vermaking of een vraag kun je tijdens de openingstijden ook gewoon binnenlopen.' },
  { v: 'Wat neem ik mee naar de eerste afspraak?', a: 'Foto\'s van jurken die je mooi vindt, en als je ze al hebt je trouwschoenen en het ondergoed dat je die dag wilt dragen. Heb je nog geen foto\'s, dan is dat ook geen probleem: er wordt goed naar je geluisterd en we tekenen het samen uit.' },
  { v: 'Maken jullie alleen bruidsjurken?', a: 'Nee. Bei is kleermaker. Naast bruidsjurken maakt en vermaakt ze jurken voor bruidsmoeders, bruidsmeisjes en bruidsjonkers, gala- en avondkleding, en gewone kleding op maat.' },
  { v: 'In welke plaatsen komen jullie klanten vandaan?', a: `Bruiden komen uit ${site.plaats} en de hele omgeving, onder meer uit ${werkgebied.slice(1, 8).join(', ')} en verder.` },
];
---
<Base
  title="Bruidsatelier Rotterdam | Bei Couture"
  description="Bruidsjurk op maat, trouwjurk vermaken, bruidsmoeder en bruidsmeisjes. Bruidsatelier Bei Couture, Hoogstraat 89A Rotterdam. Bel 06 53 61 25 43."
  kruimels={[{ naam: 'Home', url: new URL(url(''), Astro.site).href }]}
  schema={[faqSchema(faq)]}
>
  <Kop />
  <main id="inhoud">

    <!-- HERO -->
    <section class="font-sans relative isolate flex min-h-[100svh] flex-col overflow-hidden bg-[#1b1716] text-[#ffffff]">
      <Picture src={hero} formats={['avif', 'webp']} widths={[640, 960, 1400, 2000]} sizes="100vw" alt="Een bruid wordt in haar kanten trouwjurk geholpen in het atelier" loading="eager" fetchpriority="high" class="absolute inset-0 -z-10 h-full w-full object-cover object-[62%_40%] max-md:object-[60%_62%]" />
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,#1b1716f2_0%,#1b1716c7_42%,#1b171640_80%,#1b171626_100%)] max-md:bg-[linear-gradient(180deg,#1b1716b3_0%,#1b171699_35%,#1b1716e6_78%,#1b1716_100%)]"></div>
      <div class="wrap flex flex-1 flex-col justify-end pb-[5.5rem] pt-28 md:pb-20 md:pt-36 lg:pt-44">
        <p class="eyebrow eyebrow-licht !font-sans !text-[.8125rem] !font-semibold !tracking-[.2em]">Bruidsatelier in Rotterdam</p>
        <h1 class="hero-kop mt-4 max-w-[13ch] text-hero md:mt-6">Uw droom wordt werkelijkheid in ons <em class="accent-hero">atelier.</em></h1>
        <p class="mt-5 max-w-xl text-[1.06rem] text-[#ffffffe6] md:mt-7 md:text-[1.375rem]">Bruidsjurken op maat, trouwjurken vermaakt en jurken voor de bruidsmoeder, de bruidsmeisjes en de bruidsjonkers. Gemaakt door Bei zelf, in haar atelier aan de Hoogstraat.</p>
        <div class="mt-7 flex flex-wrap gap-3 md:mt-9">
          <a href={url('contact/')} class="knop knop-merk !rounded-[2px] !font-sans !normal-case !tracking-[.01em] !text-[1.05rem] !font-semibold">Afspraak maken <Icoon naam="pijl" /></a>
          <a href={site.telHref} class="knop knop-wit num !rounded-[2px] !border-[1.5px] !font-sans !normal-case !tracking-[.01em] !text-[1.05rem] !font-semibold"><Icoon naam="tel" />{site.tel}</a>
        </div>
        <ul class="mt-6 flex flex-wrap items-center gap-x-7 gap-y-2 text-[.95rem] text-[#ffffffd9] md:mt-9">
          <li class="flex items-center gap-2"><span class="flex text-strik">{[1,2,3,4,5].map(() => <Icoon naam="ster" class="h-4 w-4" />)}</span><strong class="font-semibold text-[#ffffff]">{site.google.score}</strong> op Google, {site.google.aantal} reviews</li>
          <li class="flex items-center gap-2"><Icoon naam="klok" class="h-4 w-4 text-strik" /><span data-nu>Di t/m vr en zondag open</span></li>
          <li class="flex items-center gap-2"><Icoon naam="kalender" class="h-4 w-4 text-strik" />Ook buiten de openingstijden op afspraak</li>
        </ul>
      </div>
      <p class="absolute bottom-3 right-4 hidden text-[.7rem] text-wit/55 md:block">Sfeerfoto (Unsplash)</p>
    </section>

    <!-- FEITENREGEL: zacht roze lint onder de hero, één rustige regel over de hele breedte. -->
    <section class="bg-strik-zacht" aria-label="Bei Couture in het kort">
      <ul class="wrap flex flex-wrap items-center justify-center gap-x-10 gap-y-2 py-4 text-[.95rem] text-inkt-2 md:justify-between md:py-5 lg:gap-x-6">
        <li>Eigen atelier sinds <span class="num font-kop text-[1.35rem] leading-none text-merk">1997</span></li>
        <li>Bruidsmode sinds <span class="num font-kop text-[1.35rem] leading-none text-merk">2009</span></li>
        <li>Ook op <span class="font-kop text-[1.35rem] leading-none text-merk">zondag</span> open</li>
        <li>Alles door <span class="font-kop text-[1.35rem] leading-none text-merk">Bei</span> zelf gemaakt</li>
      </ul>
    </section>

    <!-- ATELIER / DIENSTEN: een rij hoge foto's, alleen de naam eronder. Swipen op de telefoon, pijl op desktop. -->
    <section id="atelier" class="bg-ivoor pb-14 pt-14 md:pb-20 md:pt-20">
      <div class="wrap">
        <div class="flex items-end justify-between gap-6">
          <h2 class="text-[2rem] md:text-[2.4rem]">Het atelier</h2>
          <div class="hidden gap-2 md:flex">
            <button type="button" data-rij-vorige class="grid h-11 w-11 place-items-center rounded-full border border-ivoor-3 text-inkt transition-colors hover:border-inkt disabled:opacity-30" aria-label="Vorige diensten">
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M15 6 9 12l6 6" /></svg>
            </button>
            <button type="button" data-rij-volgende class="grid h-11 w-11 place-items-center rounded-full border border-ivoor-3 text-inkt transition-colors hover:border-inkt disabled:opacity-30" aria-label="Volgende diensten">
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
            </button>
          </div>
        </div>

        <ul class="rij mt-8 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-2 md:mt-10 md:gap-5" data-rij tabindex="0" aria-label="Diensten, horizontaal te scrollen">
          {diensten.map((d) => (
            <li class="w-[72vw] flex-none snap-start sm:w-[44vw] lg:w-[calc((100%-3.75rem)/4)]">
              <a href={url(`${d.slug}/`)} class="fotolink group block">
                <span class="foto block aspect-[3/4] bg-ivoor-2">
                  <Picture src={d.img} formats={['avif', 'webp']} widths={[400, 560, 800]} sizes="(min-width: 1024px) 24vw, (min-width: 640px) 44vw, 72vw" alt={d.alt} class="h-full w-full object-cover" style={`object-position:${d.pos}`} />
                </span>
                <span class="mt-4 block text-[.78rem] font-medium uppercase tracking-[.22em] text-inkt transition-colors group-hover:text-merk">{d.kaartTitel}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- OVER BEI: in dezelfde kolom als Het atelier. Foto links op eigen formaat (de bron is klein),
         rechts op zacht roze haar verhaal, drie beloftes en een knop. -->
    <section id="bei" class="bg-strik-zacht py-16 md:py-24">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-14">
        <div class="lg:col-span-5">
          <Picture src={bei} formats={['avif', 'webp']} widths={[480, 720, 960]} sizes="(min-width: 1024px) 480px, 100vw" alt="Bei speldt het lijfje van een trouwjurk af op de paspop in haar atelier" class="foto aspect-[3/4] w-full object-cover object-[50%_30%]" />
        </div>
        <div class="flex flex-col justify-center lg:col-span-7 lg:pl-4 xl:pl-10">
          <p class="eyebrow">Over Bei</p>
          <h2 class="mt-5 text-[2.2rem] md:text-[2.8rem]">De vrouw achter <span class="text-merk">de jurk</span></h2>
          <p class="mt-7 max-w-xl text-steen">Bei Couture, dat is Bei. Geboren in China, al een lange tijd in Nederland, en sinds 1997 met een eigen atelier. Ze is een perfectionist en wil het liefst alles zelf doen: het gesprek, het meten, het knippen en het naaien. Sinds 2009 is bruidsmode haar specialisme, en ze krijgt nog steeds een glimlach op haar gezicht als een bruid weer super tevreden is.</p>

          <ul class="mt-10 max-w-xl divide-y divide-merk/20 border-y border-merk/20 bg-wit/60">
            {[
              ['Alles door Bei zelf', 'Dezelfde persoon doet het gesprek, meet je op, knipt en naait. Geen tussenpersoon, geen atelier elders.'],
              ['De tijd die het nodig heeft', 'Meestal drie pasbeurten: een proefjurk, een proefmodel in de gekozen stof en de complete jurk.'],
              ['Geen enkele opgave is teveel', 'Haar eigen woorden. Een gekleurde trouwjurk, een grote maat, de jurk van je moeder: het kan.'],
            ].map(([k, t]) => (
              <li class="px-6 py-5">
                <p class="text-[.82rem] font-medium uppercase tracking-[.2em]">{k}</p>
                <p class="mt-1.5 text-[.98rem] text-steen">{t}</p>
              </li>
            ))}
          </ul>

          <div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-4">
            <a href={waHoi} class="knop knop-merk"><Icoon naam="wa" />Plan een kennismaking</a>
            <a href={url('over-bei/')} class="text-[.8rem] font-medium uppercase tracking-[.25em] text-merk underline decoration-merk/40 underline-offset-[6px]">Lees meer over Bei</a>
          </div>
        </div>
      </div>
    </section>

    <!-- REVIEWS -->
    <Reviews />

    <!-- WERKWIJZE -->
    <Werkwijze />

    <!-- IN HET KORT -->
    <Feiten />

    <!-- AFSPRAAK -->
    <Afspraak />

    <!-- BEZOEK -->
    <section id="bezoek" class="bg-ivoor py-24 md:py-32">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-14">
        <div class="min-w-0 lg:col-span-5">
          <p class="eyebrow">Bezoek het atelier</p>
          <h2 class="mt-5 text-4xl">Hoogstraat <em class="accent">89A.</em></h2>
          <p class="mt-6 text-lg text-steen">Het atelier zit midden in Rotterdam, in het pand van {site.inPand}. Bruiden komen uit de hele regio: {werkgebied.slice(1, 7).join(', ')} en verder.</p>
          <ul class="mt-8 space-y-4">
            <li class="flex gap-4"><Icoon naam="pin" class="mt-1 h-5 w-5 flex-none text-merk" /><span>{site.straat}, {site.postcode} {site.plaats}<br /><span class="text-sm text-steen">Gevestigd in {site.inPand}</span></span></li>
            <li class="flex gap-4"><Icoon naam="tel" class="mt-1 h-5 w-5 flex-none text-merk" /><a href={site.telHref} class="link num">{site.tel}</a></li>
            <li class="flex gap-4"><Icoon naam="mail" class="mt-1 h-5 w-5 flex-none text-merk" /><a href={`mailto:${site.mail}`} class="link">{site.mail}</a></li>
          </ul>
          <div class="mt-7 flex flex-wrap gap-3 md:mt-9">
            <a href={site.route} class="knop knop-inkt"><Icoon naam="pin" />Route plannen</a>
            <a href={waHoi} class="knop knop-rand"><Icoon naam="wa" />WhatsApp</a>
          </div>
        </div>
        <div class="lg:col-span-7">
          <Tijden />
        </div>
      </div>
    </section>

    <Faq vragen={faq} kop="Vragen over het atelier" achtergrond="bg-ivoor-2" />
    <Cta />
  </main>
  <Voet />
</Base>
